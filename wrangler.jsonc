{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mattmakes3d",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mattmakes3d-db",
			"database_id": "ad954fb9-caea-4cad-8249-bade7f59cdf2",
		},
		{
			// Traffic is reported into the Matt Evans Tech dashboard, which
			// keeps every site on its own tab. Analytics rows only.
			"binding": "ANALYTICS",
			"database_name": "mattevanstech-db",
			"database_id": "8492d6b5-bf29-496d-afab-438b9104de40",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "mattmakes3d-media",
		},
	],
	// EmDash/Astro session store. The id is filled in after:
	//   npx wrangler kv namespace create SESSION
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "15c18297671b4ec2995d8184ecbb80c8",
		},
	],
	// Cloudflare Images binding for Astro image optimization.
	"images": {
		"binding": "IMAGES",
	},
	// Serve the site on the apex domain (zone is on Cloudflare).
	"routes": [
		{ "pattern": "mattmakes3d.com", "custom_domain": true },
	],
}
