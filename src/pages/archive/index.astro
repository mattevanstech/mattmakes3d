---
// archive/index.astro — full print history with search + grid/timeline toggle
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrintCard from '../../components/PrintCard.astro';
import { getPrints } from '../../lib/notion.js';

const printsRaw = await getPrints();
const prints = [...printsRaw].sort((a, b) => b.date.localeCompare(a.date));
const printsJson = JSON.stringify(prints);
---

<BaseLayout
  currentPage="archive"
  title="Archive – MattMakes3D"
  description="Full history of 3D prints by Matt Evans."
>
  <!-- ── TITLE BAND ────────────────────────────────────────────── -->
  <section class="hero-band">
    <div class="hero-band-inner" style="display:block; padding-bottom: 32px;">
      <div class="fade-up fade-up-1">
        <span class="hero-eyebrow">The Index</span>
        <h1 style="margin-top:12px;">Print<em>Archive</em></h1>
        <p class="hero-sub">
          The full history. Every model, in the order it came off the bed.
        </p>

        <div class="archive-toolbar">
          <div class="search-wrap">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="archive-search" placeholder="Search makes…" autocomplete="off" spellcheck="false" />
            <button id="search-clear" class="search-clear" aria-label="Clear search">✕</button>
          </div>
          <div class="view-toggle" role="tablist" aria-label="View toggle">
            <button id="btn-grid" class="view-btn active" type="button" role="tab" aria-selected="true">
              <svg viewBox="0 0 14 14"><rect x="0" y="0" width="6" height="6"/><rect x="8" y="0" width="6" height="6"/><rect x="0" y="8" width="6" height="6"/><rect x="8" y="8" width="6" height="6"/></svg>
              Grid
            </button>
            <button id="btn-timeline" class="view-btn" type="button" role="tab" aria-selected="false">
              <svg viewBox="0 0 14 14"><rect x="0" y="1" width="14" height="2" rx="1"/><rect x="0" y="6" width="14" height="2" rx="1"/><rect x="0" y="11" width="14" height="2" rx="1"/></svg>
              Timeline
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── RESULTS ──────────────────────────────────────────────── -->
  <section class="site-section fade-up fade-up-2">
    <div class="section-heading">
      <span class="eyebrow">Complete History</span>
      <h2 class="section-heading-title" id="results-label">
        {prints.length} <em>Make{prints.length === 1 ? '' : 's'}</em>
      </h2>
    </div>

    <!-- Grid -->
    <div id="prints-grid" class="makes-grid">
      {prints.map(print => <PrintCard print={print} />)}
    </div>

    <!-- Timeline (built by JS) -->
    <div id="timeline-view" style="display:none;"></div>

    <!-- No results -->
    <div id="no-results" class="no-results">
      No makes found matching "<span id="no-results-term"></span>"
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ printsJson }}>
(function () {
  const MONTHS = [
    'January','February','March','April','May','June',
    'July','August','September','October','November','December'
  ];

  function init() {
    const prints       = JSON.parse(printsJson);
    const searchInput  = document.getElementById('archive-search');
    const searchClear  = document.getElementById('search-clear');
    const resultsLabel = document.getElementById('results-label');
    const gridView     = document.getElementById('prints-grid');
    const timelineView = document.getElementById('timeline-view');
    const noResults    = document.getElementById('no-results');
    const noResultsTerm= document.getElementById('no-results-term');
    const btnGrid      = document.getElementById('btn-grid');
    const btnTimeline  = document.getElementById('btn-timeline');
    if (!searchInput || !btnGrid || !btnTimeline) return;

    let currentView  = 'grid';
    let currentQuery = '';

    btnGrid.addEventListener('click', function () {
      if (currentView === 'grid') return;
      currentView = 'grid';
      btnGrid.classList.add('active'); btnGrid.setAttribute('aria-selected', 'true');
      btnTimeline.classList.remove('active'); btnTimeline.setAttribute('aria-selected', 'false');
      render();
    });

    btnTimeline.addEventListener('click', function () {
      if (currentView === 'timeline') return;
      currentView = 'timeline';
      btnTimeline.classList.add('active'); btnTimeline.setAttribute('aria-selected', 'true');
      btnGrid.classList.remove('active'); btnGrid.setAttribute('aria-selected', 'false');
      render();
    });

    searchInput.addEventListener('input', function () {
      currentQuery = searchInput.value.trim().toLowerCase();
      searchClear.style.opacity       = currentQuery ? '1' : '0';
      searchClear.style.pointerEvents = currentQuery ? 'auto' : 'none';
      render();
    });

    searchClear.addEventListener('click', function () {
      searchInput.value = '';
      currentQuery = '';
      searchClear.style.opacity = '0';
      searchClear.style.pointerEvents = 'none';
      searchInput.focus();
      render();
    });

    function filteredPrints() {
      if (!currentQuery) return prints;
      return prints.filter(function (p) {
        return p.title.toLowerCase().includes(currentQuery)
          || (p.date || '').slice(0, 4).includes(currentQuery)
          || (p.model_source || '').toLowerCase().includes(currentQuery);
      });
    }

    function render() {
      var filtered = filteredPrints();
      var total = filtered.length;

      if (currentQuery) {
        resultsLabel.innerHTML = total + ' result' + (total !== 1 ? 's' : '') + ' for &ldquo;' + escapeHtml(searchInput.value.trim()) + '&rdquo;';
      } else {
        resultsLabel.innerHTML = prints.length + ' <em class="section-heading-italic">Make' + (prints.length === 1 ? '' : 's') + '</em>';
      }

      if (total === 0) {
        gridView.style.display = 'none';
        timelineView.style.display = 'none';
        noResults.style.display = 'flex';
        noResultsTerm.textContent = searchInput.value.trim();
        return;
      }
      noResults.style.display = 'none';

      if (currentView === 'grid') {
        gridView.style.display = '';
        timelineView.style.display = 'none';
        renderGrid(filtered);
      } else {
        gridView.style.display = 'none';
        timelineView.style.display = 'flex';
        renderTimeline(filtered);
      }
    }

    function renderGrid(filtered) {
      var cards = gridView.querySelectorAll('.make-card');
      cards.forEach(function (card) {
        var titleLower = (card.dataset.titleLower || card.dataset.title || '').toLowerCase();
        var year = card.dataset.year;
        var match = filtered.some(function (p) {
          return p.title.toLowerCase() === titleLower && (p.date || '').slice(0, 4) === year;
        });
        card.style.display = match ? '' : 'none';
      });
    }

    function renderTimeline(filtered) {
      var grouped = {};
      filtered.forEach(function (p) {
        var d = new Date(p.date + 'T12:00:00');
        var year = d.getFullYear();
        var month = d.getMonth();
        if (!grouped[year]) grouped[year] = {};
        if (!grouped[year][month]) grouped[year][month] = [];
        grouped[year][month].push(p);
      });

      var years = Object.keys(grouped).sort(function (a, b) { return b - a; });
      var html = '';

      years.forEach(function (year) {
        var months = Object.keys(grouped[year]).sort(function (a, b) { return b - a; });
        var yearTotal = months.reduce(function (acc, m) { return acc + grouped[year][m].length; }, 0);

        html += '<div class="timeline-year-group">';
        html += '<div class="timeline-year-header">'
              + '<span class="timeline-year-label">' + year + '</span>'
              + '<span class="timeline-year-count">' + yearTotal + ' make' + (yearTotal !== 1 ? 's' : '') + '</span>'
              + '</div>';

        months.forEach(function (month) {
          var entries = grouped[year][month];
          html += '<div class="timeline-month-group">';
          html += '<div class="timeline-month-header">'
                + '<div class="timeline-month-name">' + MONTHS[month] + '</div>'
                + '<div class="timeline-month-count">' + entries.length + ' make' + (entries.length !== 1 ? 's' : '') + '</div>'
                + '</div>';
          html += '<div class="timeline-entries">';

          entries.forEach(function (p) {
            var d = new Date(p.date + 'T12:00:00');
            var dateStr = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            var thumb = p.photo
              ? '<img src="' + escapeAttr(p.photo) + '" alt="' + escapeAttr(p.title) + '" loading="lazy" />'
              : '<div class="timeline-thumb-placeholder">◈</div>';
            var href = p.model_url || '#';
            var target = p.model_url ? ' target="_blank" rel="noopener noreferrer"' : '';
            var linkIcon = p.model_url
              ? '<svg class="timeline-link-icon" width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M14 3h7v7h-2V6.41L10.41 15 9 13.59 17.59 5H14V3zM5 5h6V3H3v18h18v-8h-2v6H5V5z"/></svg>'
              : '<span class="timeline-view-link">View →</span>';

            html += '<a href="' + escapeAttr(href) + '" class="timeline-entry"' + target + '>'
                  +   '<div class="timeline-thumb">' + thumb + '</div>'
                  +   '<div class="timeline-info">'
                  +     '<div class="timeline-title">' + escapeHtml(p.title) + '</div>'
                  +     '<div class="timeline-meta">'
                  +       '<span class="timeline-date">' + dateStr + '</span>'
                  +       (p.model_source ? '<span class="sep">·</span><span class="timeline-source">' + escapeHtml(p.model_source) + '</span>' : '')
                  +     '</div>'
                  +   '</div>'
                  +   linkIcon
                  + '</a>';
          });

          html += '</div></div>';
        });

        html += '</div>';
      });

      timelineView.innerHTML = html;
    }

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function escapeAttr(s) {
      return String(s).replace(/"/g, '&quot;');
    }

    render();
  }

  // Run on first load AND after every ViewTransitions navigation
  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
})();
</script>
