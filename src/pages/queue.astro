---
// queue.astro — full print queue
import BaseLayout from '../layouts/BaseLayout.astro';
import { getQueue } from '../lib/notion.js';

const queue = await getQueue();
---

<BaseLayout
  title="Print Queue – MattMakes3D"
  description="Everything currently queued up to print at MattMakes3D."
  currentPage="queue"
>
  <!-- ── TITLE BAND ────────────────────────────────────────────── -->
  <section class="hero-band">
    <div class="hero-band-inner" style="display:block; padding-bottom: 32px;">
      <div class="fade-up fade-up-1">
        <span class="hero-eyebrow">Coming Soon</span>
        <h1 style="margin-top:12px;">Print<em>Queue.</em></h1>
        <p class="hero-sub">Everything lined up and waiting for the bed.</p>

        <div class="queue-count-row">
          <strong>{queue.length}</strong> Model{queue.length === 1 ? '' : 's'} Queued
        </div>
      </div>
    </div>
  </section>

  <!-- ── LIST ──────────────────────────────────────────────────── -->
  <section class="site-section fade-up fade-up-2">
    {queue.length === 0 ? (
      <div class="queue-empty">
        The queue is empty — nothing lined up yet.
      </div>
    ) : (
      <ol class="queue-list">
        {queue.map((item, i) => (
          <li class="queue-row">
            <a
              href={item.url || '#'}
              target={item.url ? '_blank' : undefined}
              rel={item.url ? 'noopener noreferrer' : undefined}
            >
              <span class="queue-row-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="queue-row-info">
                <div class="queue-row-title">{item.title}</div>
                {item.source && <div class="queue-row-source">{item.source}</div>}
              </div>
              <span class="queue-row-cta">View Model <span>→</span></span>
              <span class="queue-row-cta-mobile">→</span>
            </a>
          </li>
        ))}
      </ol>
    )}

    <a href="/" class="queue-back">
      <span>←</span> Back to latest prints
    </a>
  </section>
</BaseLayout>
