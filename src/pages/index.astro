---
// index.astro — home: hero + queue preview + featured + all makes grid
import BaseLayout from '../layouts/BaseLayout.astro';
import PrintCard from '../components/PrintCard.astro';
import QueuePanel from '../components/QueuePanel.astro';
import { getPrints, getQueue } from '../lib/notion.js';

const prints = await getPrints();
const queue  = await getQueue();
const queuePreview = queue.slice(0, 3);

const sorted = [...prints].sort((a, b) => b.date.localeCompare(a.date));
const markedFeatured = sorted.filter(p => p.featured);
const backfill = sorted.filter(p => !p.featured);
const featuredItems = [...markedFeatured, ...backfill].slice(0, 2);
const allGrid = sorted.filter(p => !featuredItems.includes(p));
const grid = allGrid.slice(0, 12);
const totalMakes = sorted.length;
const hasMore = allGrid.length > 12;
---

<BaseLayout currentPage="home">

  <!-- ── HERO BAND ────────────────────────────────────────────── -->
  <section class="hero-band">
    <div class="hero-band-inner">
      <div class="hero fade-up fade-up-1">
        <span class="hero-eyebrow">Print Log</span>
        <h1>Fresh Off<em>The Bed.</em></h1>
        <p class="hero-sub">
          A running record of what's coming off the printer. Models, makes,
          and everything in between.
        </p>
        <div class="hero-buttons">
          <a href="/archive" class="btn btn-primary">
            Browse Archive
            <span class="btn-mono-arrow">→</span>
          </a>
          <a href="/queue" class="btn btn-outline">
            Print Queue ({queue.length})
          </a>
        </div>
      </div>

      <div class="fade-up fade-up-2">
        <QueuePanel items={queuePreview} totalCount={queue.length} />
      </div>
    </div>
  </section>

  <!-- ── FEATURED MAKES ───────────────────────────────────────── -->
  {featuredItems.length > 0 && (
    <section class="site-section fade-up fade-up-3">
      <div class="section-heading">
        <span class="eyebrow">Top Picks</span>
        <h2 class="section-heading-title">Featured <em>Makes</em></h2>
      </div>
      <div class="featured-grid">
        {featuredItems.map((item) => (
          <PrintCard print={item} featured={true} />
        ))}
      </div>
    </section>
  )}

  <!-- ── ALL MAKES GRID ───────────────────────────────────────── -->
  <section class="site-section fade-up fade-up-4" style="padding-top: 0;">
    <div class="section-heading-row">
      <div class="section-heading" style="margin-bottom:0;">
        <span class="eyebrow">The Collection</span>
        <h2 class="section-heading-title">
          All <em>Makes</em>
          <span class="section-heading-count">{totalMakes}</span>
        </h2>
      </div>
      {hasMore && (
        <a href="/archive" class="view-all">
          View All {totalMakes} Makes <span>→</span>
        </a>
      )}
    </div>
    <div class="makes-grid">
      {grid.map(print => <PrintCard print={print} />)}
    </div>
  </section>

</BaseLayout>
