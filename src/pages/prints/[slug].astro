---
// prints/[slug].astro — individual print page with per-print OG tags
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PortableText } from 'emdash/ui';
import { getPrint } from '../../lib/notion.js';

const { slug } = Astro.params;
const print = await getPrint(slug);
if (!print) return Astro.redirect('/404');

const hasNotes = Array.isArray(print.notes) && print.notes.length > 0;

const formattedDate = print.date
  ? new Date(print.date).toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric',
    })
  : '';

const ogDescription = [
  print.title,
  formattedDate ? `Printed ${formattedDate}` : null,
  print.model_source ? `Model from ${print.model_source}` : null,
  'See all my 3D prints at MattMakes3D.com.',
].filter(Boolean).join(' · ');

// Print pages: use the print photo as the OG card; fall back to the brand card.
const ogImage = print.photo?.startsWith('http')
  ? print.photo
  : 'https://mattmakes3d.com/assets/og-card.png';
---

<BaseLayout
  title={`${print.title} — MattMakes3D`}
  description={ogDescription}
  ogImage={ogImage}
>
  <main class="print-page fade-up fade-up-1">
    <a href="/archive" class="print-page-back">
      <span>←</span> Back to Archive
    </a>

    <div class="print-page-card">
      <div class="print-page-photo">
        {print.photos.length > 1 ? (
          <div class="print-gallery" data-gallery>
            <div class="print-gallery-track" data-track>
              {print.photos.map((src, i) => (
                <div class="print-gallery-slide">
                  <img src={src} alt={`${print.title} — photo ${i + 1} of ${print.photos.length}`} loading={i === 0 ? 'eager' : 'lazy'} />
                </div>
              ))}
            </div>
            <button class="print-gallery-nav prev hide" data-prev type="button" aria-label="Previous photo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="print-gallery-nav next" data-next type="button" aria-label="Next photo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <div class="print-gallery-dots" data-dots>
              {print.photos.map((_, i) => (
                <button class="print-gallery-dot" data-dot type="button" aria-label={`Go to photo ${i + 1}`}></button>
              ))}
            </div>
          </div>
        ) : (
          print.photo && <img src={print.photo} alt={print.title} />
        )}
      </div>

      <div class="print-page-info">
        <span class="eyebrow print-page-eyebrow">Print Details</span>
        <h1 class="print-page-title">{print.title}</h1>

        <div class="print-page-meta">
          {formattedDate && (
            <div class="print-page-meta-row">
              <span class="print-page-meta-label">Printed</span>
              <span class="print-page-meta-value">{formattedDate}</span>
            </div>
          )}
          {print.model_source && (
            <div class="print-page-meta-row">
              <span class="print-page-meta-label">Source</span>
              <span class="print-page-meta-value">{print.model_source}</span>
            </div>
          )}
        </div>

        <div class="print-page-actions">
          {print.model_url && (
            <a href={print.model_url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M14 3h7v7h-2V6.41L10.41 15 9 13.59 17.59 5H14V3zM5 5h6V3H3v18h18v-8h-2v6H5V5z"/></svg>
              View Model
            </a>
          )}
          <a href="/archive" class="btn btn-outline">All Prints</a>
        </div>
      </div>
    </div>

    {hasNotes && (
      <section class="print-page-notes fade-up fade-up-2">
        <span class="eyebrow">Maker Notes</span>
        <div class="print-page-notes-body">
          <PortableText value={print.notes} />
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .print-page-notes {
    max-width: 760px;
    margin: 48px auto 0;
    padding: 0 var(--pad-x, 24px);
  }
  .print-page-notes .eyebrow {
    display: flex;
    margin-bottom: 12px;
  }
  .print-page-notes-body {
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink);
  }
  .print-page-notes-body :global(p) { margin: 0 0 1.1em; }
  .print-page-notes-body :global(h2) { font-size: 1.4em; margin: 1.5em 0 0.5em; }
  .print-page-notes-body :global(h3) { font-size: 1.15em; margin: 1.3em 0 0.4em; }
  .print-page-notes-body :global(ul),
  .print-page-notes-body :global(ol) { margin: 0 0 1.1em; padding-left: 1.4em; }
  .print-page-notes-body :global(li) { margin: 0.3em 0; }
  .print-page-notes-body :global(a) { color: var(--accent); text-decoration: underline; }
  .print-page-notes-body :global(blockquote) {
    margin: 1.2em 0;
    padding-left: 16px;
    border-left: 3px solid var(--accent);
    color: var(--ink-2);
  }
  .print-page-notes-body :global(img) { max-width: 100%; height: auto; border-radius: 12px; }
</style>

<script>
  // Print photo carousel — arrows, dots, swipe (native scroll-snap), keyboard.
  function initGalleries() {
    document.querySelectorAll('[data-gallery]').forEach((g) => {
      if ((g as HTMLElement).dataset.init) return;
      (g as HTMLElement).dataset.init = '1';
      const track = g.querySelector('[data-track]') as HTMLElement;
      const dots = Array.from(g.querySelectorAll('[data-dot]'));
      const prev = g.querySelector('[data-prev]');
      const next = g.querySelector('[data-next]');
      const count = g.querySelectorAll('.print-gallery-slide').length;
      const indexOf = () => Math.round(track.scrollLeft / track.clientWidth);
      // Instant scroll: a CSS smooth-scroll fights `scroll-snap-type: mandatory`
      // (the snap yanks an in-flight animation back to the origin). Native touch
      // swipe stays smooth via the browser's own momentum + snap. Clamped (no
      // wrap) so the ends are hard stops.
      const goTo = (i: number) => {
        track.scrollLeft = Math.max(0, Math.min(count - 1, i)) * track.clientWidth;
      };
      const sync = () => {
        const i = indexOf();
        dots.forEach((d, k) => d.classList.toggle('active', k === i));
        // No back button on the first photo, no next button on the last.
        prev?.classList.toggle('hide', i <= 0);
        next?.classList.toggle('hide', i >= count - 1);
      };
      const step = (n: number) => { goTo(indexOf() + n); sync(); };
      prev?.addEventListener('click', () => step(-1));
      next?.addEventListener('click', () => step(1));
      dots.forEach((d, k) => d.addEventListener('click', () => { goTo(k); sync(); }));
      // Direct sync (not rAF-wrapped) so dots/buttons also track native swipe reliably.
      track.addEventListener('scroll', sync, { passive: true });
      g.addEventListener('keydown', (e) => {
        const ev = e as KeyboardEvent;
        if (ev.key === 'ArrowLeft') { ev.preventDefault(); step(-1); }
        if (ev.key === 'ArrowRight') { ev.preventDefault(); step(1); }
      });
      sync();
    });
  }
  document.addEventListener('astro:page-load', initGalleries);
  initGalleries();
</script>
