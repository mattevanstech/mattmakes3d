---
// prints/[slug].astro — individual print page with per-print OG tags
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPrints } from '../../lib/notion.js';

export async function getStaticPaths() {
  const prints = await getPrints();
  return prints.map(print => ({
    params: { slug: print.slug },
    props: { print },
  }));
}

const { print } = Astro.props;

const formattedDate = print.date
  ? new Date(print.date).toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric',
    })
  : '';

const ogDescription = [
  print.title,
  formattedDate ? `Printed ${formattedDate}` : null,
  print.model_source ? `Model from ${print.model_source}` : null,
  'See all my 3D prints at MattMakes3D.com.',
].filter(Boolean).join(' · ');

// Print pages: use the print photo as the OG card; fall back to the brand card.
const ogImage = print.photo?.startsWith('http')
  ? print.photo
  : 'https://mattmakes3d.com/assets/og-card.png';
---

<BaseLayout
  title={`${print.title} — MattMakes3D`}
  description={ogDescription}
  ogImage={ogImage}
>
  <main class="print-page fade-up fade-up-1">
    <a href="/archive" class="print-page-back">
      <span>←</span> Back to Archive
    </a>

    <div class="print-page-card">
      <div class="print-page-photo">
        {print.photo && <img src={print.photo} alt={print.title} />}
      </div>

      <div class="print-page-info">
        <span class="eyebrow print-page-eyebrow">Print Details</span>
        <h1 class="print-page-title">{print.title}</h1>

        <div class="print-page-meta">
          {formattedDate && (
            <div class="print-page-meta-row">
              <span class="print-page-meta-label">Printed</span>
              <span class="print-page-meta-value">{formattedDate}</span>
            </div>
          )}
          {print.model_source && (
            <div class="print-page-meta-row">
              <span class="print-page-meta-label">Source</span>
              <span class="print-page-meta-value">{print.model_source}</span>
            </div>
          )}
        </div>

        <div class="print-page-actions">
          {print.model_url && (
            <a href={print.model_url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M14 3h7v7h-2V6.41L10.41 15 9 13.59 17.59 5H14V3zM5 5h6V3H3v18h18v-8h-2v6H5V5z"/></svg>
              View Model
            </a>
          )}
          <a href="/archive" class="btn btn-outline">All Prints</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
