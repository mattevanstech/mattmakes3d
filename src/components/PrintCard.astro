---
// PrintCard.astro — a single make in the grid
import type { Print } from '../content/types';
import { toSlug } from '../lib/notion.js';

interface Props {
  print: Print;
  featured?: boolean;
}
const { print, featured = false } = Astro.props;

const formattedDate = new Date(print.date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});
const slug = print.slug || toSlug(print.title);
---

<div
  class:list={['make-card', { 'is-featured': featured }]}
  data-lightbox
  data-id={slug}
  data-title={print.title}
  data-photo={print.photo}
  data-date={print.date}
  data-model-url={print.model_url}
  data-model-source={print.model_source}
  data-title-lower={print.title.toLowerCase()}
  data-year={print.date.slice(0, 4)}
  tabindex="0"
  role="button"
  aria-label={`${print.title} — view details`}
>
  <div class="make-card-photo">
    {print.photo
      ? <img src={print.photo} alt={print.title} loading="lazy" />
      : <div class="photo-placeholder"><span>No Photo</span></div>
    }
    {featured && (
      <div class="make-card-featured-badge">Featured</div>
    )}
    <span class="make-card-hover-pill">View Details →</span>
  </div>
  <div class="make-card-body">
    <div class="make-card-title">{print.title}</div>
    <div class="make-card-meta">
      <span>{formattedDate}</span>
      {print.model_source && (
        <>
          <span class="sep">·</span>
          <span>{print.model_source}</span>
        </>
      )}
    </div>
  </div>
</div>
