---
// QueuePanel.astro — homepage sidebar showing what's queued next
import type { QueueItem } from '../content/types';

interface Props {
  items: QueueItem[];
  totalCount?: number;
}
const { items, totalCount = items.length } = Astro.props;
---

<aside class="queue-panel">
  <div class="queue-panel-header">
    <span class="eyebrow">Print Queue</span>
    {totalCount > 0 && (
      <a href="/queue" class="queue-panel-viewall">View all {totalCount} →</a>
    )}
  </div>

  {items.length === 0 ? (
    <div class="queue-empty" style="padding:32px 12px; font-size:12px;">Queue is empty</div>
  ) : (
    <div class="queue-panel-list">
      {items.map((item, i) => (
        <a
          href={item.url || '/queue'}
          class="queue-panel-item"
          target={item.url ? '_blank' : undefined}
          rel={item.url ? 'noopener noreferrer' : undefined}
        >
          <span class="queue-panel-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="queue-panel-title">{item.title}</span>
          <span class="queue-panel-source">{item.source} →</span>
        </a>
      ))}
    </div>
  )}

  {totalCount > 0 && (
    <a href="/queue" class="queue-panel-footer">
      View all {totalCount} in queue →
    </a>
  )}
</aside>
