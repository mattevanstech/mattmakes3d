---
// BaseLayout.astro — wraps every page; handles <head>, header, MakerDeck bar, footer, lightbox
import Header from '../components/Header.astro';
import MakerDeckBar from '../components/MakerDeckBar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  // Pages NOT in the main nav (e.g. /deals, /prints/[slug]) should omit this
  // or pass 'none' so no nav link is highlighted.
  currentPage?: 'home' | 'archive' | 'queue' | 'blog' | 'about' | 'none';
  ogImage?: string;
}

const {
  title = 'MattMakes3D – Fresh Off The Bed',
  description = "A showcase of Matt Evans' latest 3D prints. Models, makes, and everything fresh off the print bed.",
  currentPage = 'none',
  ogImage = 'https://mattmakes3d.com/assets/og-card.png',
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/assets/favicon-192.png" />
  <meta name="author" content="Matt Evans" />
  <link rel="canonical" href={`https://mattmakes3d.com${Astro.url.pathname}`} />

  <!-- Theme color (browser chrome, iOS Safari, PWA) -->
  <meta name="theme-color" content="#F6F1E6" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0F1730" media="(prefers-color-scheme: dark)" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={`https://mattmakes3d.com${Astro.url.pathname}`} />
  <meta property="og:site_name" content="MattMakes3D" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Fonts: Space Grotesk (display + UI) · Newsreader (italic accent) · IBM Plex Mono (mono) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/styles/global.css" />
  <ClientRouter />

  <!-- Theme bootstrap (no-FOUC): runs before paint and on every ViewTransitions navigation -->
  <script is:inline>
    (function () {
      function applyTheme() {
        try {
          var v = localStorage.getItem('mm3d-dark');
          var dark = v === '1';
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        } catch (_) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    })();
  </script>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "MattMakes3D",
    "url": "https://mattmakes3d.com",
    "description": description,
    "author": {
      "@type": "Person",
      "name": "Matt Evans",
      "url": "https://mattevanstech.com"
    }
  })} />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DYT0JD7HJM"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DYT0JD7HJM');
  </script>
</head>
<body>
  <Header currentPage={currentPage} />
  <MakerDeckBar />

  <slot />


  <Footer />
</body>
</html>
